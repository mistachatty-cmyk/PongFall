{
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|jam/|lok-updates\\.json|rules\\.html).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/lok-updates.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/jam",
      "destination": "/jam/",
      "permanent": false
    }
  ]
}
